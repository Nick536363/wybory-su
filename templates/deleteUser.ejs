<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Usunąc <%= user.username %>?</title>

    <style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    min-height: 100vh;
    padding: 20px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 16px;
    font-family: Arial, sans-serif;
    background-color: #f3f5f8;
    color: #263238;
}

h1 {
    width: 100%;
    max-width: 420px;
    margin: 0;
    padding: 32px 24px 16px;
    background-color: #ffffff;
    border: 1px solid #e3e8ef;
    border-bottom: none;
    border-radius: 14px 14px 0 0;
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.05);
    font-size: 24px;
    line-height: 1.5;
    text-align: center;
    overflow-wrap: anywhere;
}

form {
    width: 100%;
    max-width: 420px;
    margin: 0;
    padding: 0 24px;
    background-color: #ffffff;
}

form:nth-of-type(1) {
    padding-top: 8px;
}

form:nth-of-type(2) {
    padding-top: 8px;
    padding-bottom: 32px;
    border: 1px solid #e3e8ef;
    border-top: none;
    border-radius: 0 0 14px 14px;
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.05);
}

button {
    width: 100%;
    padding: 12px 16px;
    font-size: 15px;
    font-weight: 600;
    color: #ffffff;
    background-color: #3978e5;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: background-color 0.2s, transform 0.1s;
}

button:hover {
    background-color: #2863c7;
}

button:active {
    transform: scale(0.98);
}

/* Кнопка подтверждения удаления */
form:nth-of-type(2) button {
    background-color: #dc4545;
}

form:nth-of-type(2) button:hover {
    background-color: #bd3030;
}

button:focus-visible {
    outline: 3px solid rgba(57, 120, 229, 0.25);
    outline-offset: 3px;
}

@media (max-width: 480px) {
    h1 {
        padding: 24px 18px 16px;
        font-size: 21px;
    }

    form {
        padding-right: 18px;
        padding-left: 18px;
    }

    form:nth-of-type(2) {
        padding-bottom: 24px;
    }
}
</style>

</head>
<body>
    <h1>Usunąć użytkownika <%= user.username %>?</h1>
    <form method="GET" action="/panel">
        <button type="submit" autofocus>Nie, wróc</button>
    </form>
    <form method="POST" action="/delete_user">
        <button type="submit" name="ID" id="ID" value=<%= query.ID %>>Tak, usuń</button>
    </form>
</body>
</html>
<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Panel</title>

    <style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    min-height: 100vh;
    padding: 30px 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    font-family: Arial, sans-serif;
    background-color: #f3f5f8;
    color: #263238;
}

h1 {
    margin: 20px 0 24px;
    font-size: 28px;
    text-align: center;
}

body > form {
    width: 100%;
    max-width: 240px;
    margin-bottom: 24px;
}

button {
    width: 100%;
    padding: 12px 16px;
    font-size: 15px;
    font-weight: 600;
    color: #ffffff;
    background-color: #3978e5;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: background-color 0.2s, transform 0.1s;
}

button:hover {
    background-color: #2863c7;
}

button:active {
    transform: scale(0.98);
}

table {
    width: 100%;
    max-width: 760px;
    border-collapse: collapse;
    background-color: #ffffff;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.05);
}

th, td {
    padding: 16px;
    text-align: left;
    border-bottom: 1px solid #e3e8ef;
}

th {
    color: #64748b;
    background-color: #f8fafc;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
}

td {
    font-size: 15px;
    overflow-wrap: anywhere;
}

tr:last-child td {
    border-bottom: none;
}

tr:hover td {
    background-color: #f8fafc;
}

/* Кнопка удаления */
td form {
    margin: 0;
}

td button {
    width: auto;
    min-width: 70px;
    padding: 9px 12px;
    background-color: #dc4545;
}

td button:hover {
    background-color: #bd3030;
}

@media (max-width: 480px) {
    body {
        padding: 20px 10px;
    }

    h1 {
        font-size: 24px;
    }

    th, td {
        padding: 11px 8px;
        font-size: 13px;
    }

    td button {
        min-width: 55px;
        padding: 8px;
        font-size: 12px;
    }
}
</style>

</head>
<body>
    <h1>Admin Panel</h1>
    <form method="GET" action="/add_user">
        <button type="submit">Dodaj użytkownika</button>
    </form>
    <table>
        <tr>
            <th>Użytkownik</th>
            <th>Uprawnienia</th>
        </tr>
        <% users.forEach((user)=>{%>
            <tr>
                <td><%= user.username %></td>
                <td><%= user.status %></td>
                <td>
                    <form method="GET" action="/delete_user_confirm">
                        <button name="ID" id="ID" value=<%= user.ID %>>Usuń</button>
                    </form>
                </td>
            </tr>
        <%});%>
    </table>
</body>
</html>